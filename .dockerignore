# Build context hygiene. Without this the whole tree ships to the daemon, including every
# node_modules and every local artifact, which is slow and puts a developer's .env in an image.
node_modules
**/node_modules
.git
.env
.env.*
!.env.example
dist
**/dist
app/dist
packages/runtime/__snapshots__/schema
packages/runtime-client-gql/src/graphql/@generated
packages/web-inspector/src/styles/generated.css
.nx
*.log
.DS_Store
assets/*.svg
