{
  "name": "@darbotlm/core",
  "version": "1.70.1",
  "description": "Core web utilities for CopilotKit2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/darbotlabs/Darbot.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@darbotlm/shared": "workspace:*",
    "@tanstack/pacer": "^0.20.1",
    "phoenix": "^1.8.4",
    "rxjs": "7.8.1",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@darbotlm/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/phoenix": "^1.6.6",
    "@valibot/to-json-schema": "^1.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "arktype": "^2.1.29",
    "cross-env": "^10.1.0",
    "tsdown": "^0.20.3",
    "typescript": "5.8.2",
    "valibot": "^1.2.0",
    "vitest": "^3.2.4",
    "zod": "^3.25.75"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true
}
