{
  "name": "@darbotlm/channels-core",
  "version": "0.9.2",
  "description": "Platform-agnostic JSX channel engine for CopilotKit (createChannel, Thread, PlatformAdapter, ActionStore).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/darbotlabs/Darbot.git",
    "directory": "packages/channels-core"
  },
  "homepage": "https://github.com/CopilotKit/CopilotKit",
  "keywords": [
    "ai",
    "agent",
    "bot",
    "chatbot",
    "copilotkit",
    "slack",
    "teams",
    "discord",
    "ag-ui"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/state-store-conformance.d.ts",
      "import": "./dist/testing/state-store-conformance.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@darbotlm/channels-ui": "workspace:*",
    "@darbotlm/core": "workspace:*",
    "@darbotlm/shared": "workspace:*",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@darbotlm/typescript-config": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.3",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "private": true
}
