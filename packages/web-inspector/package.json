{
  "name": "@darbotlm/web-inspector",
  "version": "1.70.1",
  "description": "Lit-based web component for the CopilotKit web inspector",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/darbotlabs/Darbot.git",
    "directory": "packages/web-inspector"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run build:css && tsdown",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/generated.css -m",
    "dev": "bun run build:css && concurrently \"bun run dev:css\" \"tsdown --watch\"",
    "dev:css": "tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/generated.css --watch --minify",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@darbotlm/core": "workspace:*",
    "@darbotlm/shared": "workspace:*",
    "lit": "^3.2.0",
    "lucide": "^0.525.0",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "@darbotlm/typescript-config": "workspace:*",
    "@tailwindcss/cli": "^4.1.11",
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.8",
    "tsdown": "^0.20.3",
    "typescript": "5.8.2",
    "vite": "^7.3.2",
    "vitest": "^3.0.5",
    "ws": "^8.19.0"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true
}
